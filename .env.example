# Server Configuration
FACTORY_HOST=127.0.0.1
FACTORY_PORT=8000
FACTORY_ENV=development
LOG_LEVEL=INFO

# Persistence
DATABASE_URL=sqlite:///data/factory.db

# Azure AI Foundry (Direct Provider - Remote)
# Se completará cuando se disponga de créditos / despliegues activos
AZURE_AI_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Free Claude Code (FCC Proxy - Localhost)
FCC_ENABLED=true
FCC_ANTHROPIC_BASE_URL=http://127.0.0.1:8082/v1
FCC_RESPONSES_BASE_URL=http://127.0.0.1:8082/v1
FCC_PROXY_TOKEN=

# Microsoft Foundry Local (Evaluación local - sin descargas de modelos en esta fase)
FOUNDRY_LOCAL_ENABLED=false
FOUNDRY_LOCAL_BASE_URL=http://127.0.0.1:5272/v1
FOUNDRY_LOCAL_MODEL=

# Model Assignment per Agent
MODEL_ANALYST=fcc-default
MODEL_ARCHITECT=fcc-default
MODEL_DEVELOPER=fcc-default
MODEL_TESTER=fcc-default
MODEL_REVIEWER=fcc-default
